# Segundo disparo de rfid-hid-bt-up.sh DESPUÉS de que el HID esté arriba.
# En algunas Pi el primer bt-up corre demasiado pronto o BlueZ apaga la
# publicidad al registrar GATT; repetir aquí suele dejar advertising estable.
#
# Ruta: usuario "user" o edita en /etc. Copiar a /etc/systemd/system/ y:
#   sudo systemctl daemon-reload
#   sudo systemctl enable rfid-hid-bt-up-post.service

[Unit]
Description=Bluetooth advertising refresh (after HID GATT)
After=rfid-hid-gatt.service
Wants=rfid-hid-gatt.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Tras levantar GATT, BlueZ a veces tarda; 40 s deja el segundo bt-up con más margen
ExecStartPre=/bin/sleep 40
ExecStart=/bin/bash /home/user/Sistema_inventario_RFID/rfid_inventory/pi_ble_hid/systemd/rfid-hid-bt-up.sh
# Debe ser > duración max de rfid-hid-bt-up.sh (p. ej. ~160s)
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target
