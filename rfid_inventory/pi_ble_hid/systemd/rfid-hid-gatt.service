# Instalación: copiar a /etc/systemd/system/rfid-hid-gatt.service
# Sustituir CHANGE_ME por tu usuario Linux.
#
# Sin "After=bluetooth.service" para evitar que el arranque quede esperando
# si bluetoothd tarda o está en estado raro (causa típica de "timeout exceeded").
#
# Bluetooth visible: ejecutar rfid-hid-bt-up.sh tras el arranque.

[Unit]
Description=BLE HID keyboard (gatt_server_rfid) for RFID pistol
After=bluetooth.service rfid-hid-bt-up.service
Wants=bluetooth.service rfid-hid-bt-up.service

[Service]
Type=simple
# Sin ExecStartPre aquí (btmgmt en pre colgaba ~90s). Bluetooth: rfid-hid-bt-up.sh
TimeoutStartSec=3600
# print() a stdout aparece al instante en journalctl (si no, queda en buffer bajo systemd)
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/rfid-hid-gatt
WorkingDirectory=/home/CHANGE_ME/Sistema_inventario_RFID/rfid_inventory/pi_ble_hid
ExecStart=/usr/bin/python3 /home/CHANGE_ME/Sistema_inventario_RFID/rfid_inventory/pi_ble_hid/gatt_server_rfid.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
