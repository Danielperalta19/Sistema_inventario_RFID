# Tras GATT, ejecuta rfid-hid-btmgmt-after-gatt.sh (2x btmgmt con pausas).
# Copiar este .service y el .sh; chmod +x el .sh. enable --now
#
# Orden: rfid-hid-bt-up -> rfid-hid-gatt -> este

[Unit]
Description=btmgmt advertising on after GATT (RFID pistol)
After=rfid-hid-gatt.service
Wants=rfid-hid-gatt.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Ver rfid-hid-btmgmt-after-gatt.sh: dos pasadas y esperas; sustituir ruta user si aplica
ExecStart=/bin/bash /home/user/Sistema_inventario_RFID/rfid_inventory/pi_ble_hid/systemd/rfid-hid-btmgmt-after-gatt.sh
TimeoutStartSec=120
StandardInput=null

[Install]
WantedBy=multi-user.target
